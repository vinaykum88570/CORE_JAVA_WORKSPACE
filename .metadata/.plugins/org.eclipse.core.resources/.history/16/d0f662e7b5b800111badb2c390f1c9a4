package demo;

public class Demo{	

	 
	public static void main(String[] args) {
		
		//Second smallest Number
		int [] arr = {5, 2, 8, 3, 1};
		int largest=arr[0];
		
		for(int i=0;i<arr.length;i++) {
			
			if(arr[i] > largest) {
				largest=arr[i];
			}
			
		}
		System.out.println(largest);
		
	}
	
}